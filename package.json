{
  "name": "lk-companion",
  "version": "0.1.0",
  "private": true,
  "description": "A private, local companion app for importing, organising and maintaining a LegendKeeper project with AI assistance.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "app": "node scripts/launcher.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "dev": "node scripts/next.mjs dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/next.mjs build",
    "start": "node scripts/next.mjs start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "npm run typecheck && npm test",
    "mock:lk": "tsx scripts/mock-legendkeeper.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@legendkeeper/sdk": "4.0.0",
    "mammoth": "1.13.0",
    "next": "16.3.8",
    "node-html-parser": "9.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "ajv": "8.20.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
