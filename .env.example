# ─────────────────────────────────────────────────────────────────────────────
# LK Companion configuration. Copy this file to `.env.local` and fill it in.
# `.env.local` is ignored by Git. Never commit real keys.
# ─────────────────────────────────────────────────────────────────────────────

# LegendKeeper API key (Project Settings → Developers → API Keys).
# Requires the project owner to be on a paid plan. A MEMBER key is enough for
# reading; an ADMIN key is needed for the tag list and for creating top-level pages.
LEGENDKEEPER_API_KEY=lk_replace_me

# Optional: point the SDK at another server (a proxy or mock server for testing).
# Leave empty to use https://www.legendkeeper.com
LEGENDKEEPER_BASE_URL=

# Creating pages is ON by default (each page still needs your approval in the
# final preview). Set to "false" to make the app read-only.
LKC_ALLOW_WRITES=true

# The resource ID of a page in your project that acts as a sandbox. The write
# check creates its test page underneath it. Create an empty page called e.g.
# "LK Companion Sandbox" in LegendKeeper and paste its ID here.
LKC_SANDBOX_PARENT_ID=

# Anthropic API key for AI transformations (console.anthropic.com).
# Leave empty to use the app without AI (structural import only).
ANTHROPIC_API_KEY=sk-ant-replace_me

# Set to "false" to switch AI processing off entirely.
LKC_AI_ENABLED=true

# Claude model and effort used for transformations.
LKC_AI_MODEL=claude-opus-5-5
LKC_AI_EFFORT=high

# Local SQLite database (recipes, drafts, job history, audit log, resource index).
LKC_DATABASE_PATH=./data/lk-companion.db

# Upload and source limits. Inputs over these limits are refused, never truncated.
LKC_MAX_UPLOAD_BYTES=2000000
LKC_MAX_SOURCE_CHARS=150000
